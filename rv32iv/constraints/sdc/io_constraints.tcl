# generated by Q3TUI (fpga sdc) from constraints/sdc/sdc.json — edit that file (or use the TUI), not this one
# I/O delays: a share of the clock period is spent outside the block.
set_input_delay -clock [get_clocks i_clk_core] -max 1.5 [get_ports {i_start_req i_ld_en i_ld_req i_ld_wr_en i_ld_addr[*] i_ld_byte_en[*] i_ld_wr_data[*]}]  ;# 30% of 5 ns
set_input_delay -clock [get_clocks i_clk_core] -min 0 [get_ports {i_start_req i_ld_en i_ld_req i_ld_wr_en i_ld_addr[*] i_ld_byte_en[*] i_ld_wr_data[*]}]
set_input_delay -clock [get_clocks i_clk_core] -max 1.5 [get_ports {i_rst_n_core}]  ;# reset input, 30% of 5 ns
set_input_delay -clock [get_clocks i_clk_core] -min 0 [get_ports {i_rst_n_core}]
set_output_delay -clock [get_clocks i_clk_core] -max 1.5 [get_ports {o_sts_done o_result_label[*] o_uart_tx o_err_illegal o_halt o_ld_rd_data[*]}]  ;# 30% of 5 ns
set_output_delay -clock [get_clocks i_clk_core] -min 0 [get_ports {o_sts_done o_result_label[*] o_uart_tx o_err_illegal o_halt o_ld_rd_data[*]}]
